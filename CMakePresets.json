{
  "version": 6,
  "configurePresets": [
    {
      "name": "x64",
      "displayName": "x64 (MSVC, Ninja Multi-Config)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build",
      "architecture": { "value": "x64", "strategy": "external" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "x64", "configuration": "Debug" },
    { "name": "release", "configurePreset": "x64", "configuration": "Release" }
  ]
}
